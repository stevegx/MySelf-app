@MySelf.Api_HostAddress = http://localhost:5242

GET {{MySelf.Api_HostAddress}}/health
Accept: text/plain

###

# Barcode lookup (3017620422003 = Nutella)
GET {{MySelf.Api_HostAddress}}/api/v1/foods/barcode/3017620422003
Accept: application/json

###

# Unknown barcode -> 404 ProblemDetails
GET {{MySelf.Api_HostAddress}}/api/v1/foods/barcode/0000000000000
Accept: application/json

###

# Invalid barcode -> 400 ProblemDetails
GET {{MySelf.Api_HostAddress}}/api/v1/foods/barcode/abc
Accept: application/json

###

# Register -> 201 with access token + Set-Cookie: refreshToken
POST {{MySelf.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "demo",
  "email": "demo@example.com",
  "password": "Str0ng!Passw0rd"
}

###

# Duplicate username/email -> 400 with a username or email field error (run the request above twice)

###

# Weak password -> 400 with field errors
POST {{MySelf.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "weakpassworduser",
  "email": "weak-password@example.com",
  "password": "123"
}

###

# Login by email -> 200 with access token + Set-Cookie: refreshToken (run register above first)
POST {{MySelf.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "demo@example.com",
  "password": "Str0ng!Passw0rd"
}

###

# Login by username also works
POST {{MySelf.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "demo",
  "password": "Str0ng!Passw0rd"
}

###

# trustThisDevice:true -> the Set-Cookie gets an Expires (persistent, survives browser close).
# Omitted/false -> no Expires -> a session cookie, gone once the browser closes.
POST {{MySelf.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "demo@example.com",
  "password": "Str0ng!Passw0rd",
  "trustThisDevice": true
}

###

# Wrong password -> 401 (5x in a row -> 423 Locked for a few minutes)
POST {{MySelf.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "identifier": "demo@example.com",
  "password": "WrongPassword!1"
}

###

# Refresh -> 200 with a new access token + rotated Set-Cookie (needs a real browser/client
# to actually send the cookie automatically; from this file you'd need to paste the
# Set-Cookie value from a prior response as a Cookie header manually).
POST {{MySelf.Api_HostAddress}}/api/v1/auth/refresh

###

# Refresh with no cookie -> 401
POST {{MySelf.Api_HostAddress}}/api/v1/auth/refresh

###

# Me -> 200 with the signed-in user (paste an accessToken from register/login above)
GET {{MySelf.Api_HostAddress}}/api/v1/me
Authorization: Bearer {{accessToken}}

###

# Me without a token -> 401
GET {{MySelf.Api_HostAddress}}/api/v1/me

###

# Update profile (onboarding step 1) -> 200 with the saved profile summary.
# Re-run GET /api/v1/me above afterwards: "profile" is no longer null.
PUT {{MySelf.Api_HostAddress}}/api/v1/me/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "unitSystem": "Metric",
  "dateOfBirth": "1994-03-21",
  "heightCm": 178.5,
  "calculationSex": "Female",
  "timezone": "Europe/Athens",
  "locale": "en-GB"
}

###

# Update profile, opting out of the calorie estimate -> 200, calculationSex comes back null
PUT {{MySelf.Api_HostAddress}}/api/v1/me/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "unitSystem": "Metric",
  "dateOfBirth": "1994-03-21",
  "heightCm": 178.5
}

###

# Update profile with a future date of birth -> 400 ValidationProblem with a dateOfBirth error
PUT {{MySelf.Api_HostAddress}}/api/v1/me/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "unitSystem": "Metric",
  "dateOfBirth": "2999-01-01",
  "heightCm": 178.5
}

###

# Update profile without a token -> 401
PUT {{MySelf.Api_HostAddress}}/api/v1/me/profile
Content-Type: application/json

{
  "unitSystem": "Metric",
  "dateOfBirth": "1994-03-21",
  "heightCm": 178.5
}

###

# Nutrition estimate -> 200 with BMR/TDEE/adjustment/suggested + macros + formula version
POST {{MySelf.Api_HostAddress}}/api/v1/me/nutrition-estimate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dateOfBirth": "1994-03-21",
  "calculationSex": "Female",
  "heightCm": 170,
  "weightKg": 68,
  "activityLevel": "Moderate",
  "goalType": "Lose",
  "pace": "Standard"
}

###

# Nutrition estimate, under 18 -> 200 with nutritionEstimateAvailable=false, reason "under-18"
POST {{MySelf.Api_HostAddress}}/api/v1/me/nutrition-estimate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dateOfBirth": "2012-01-01",
  "calculationSex": "Male",
  "heightCm": 160,
  "weightKg": 50,
  "activityLevel": "Light",
  "goalType": "Maintain"
}

###

# Nutrition estimate, Lose goal with no pace -> 400 ValidationProblem with a "pace" error
POST {{MySelf.Api_HostAddress}}/api/v1/me/nutrition-estimate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dateOfBirth": "1994-03-21",
  "calculationSex": "Female",
  "heightCm": 170,
  "weightKg": 68,
  "activityLevel": "Moderate",
  "goalType": "Lose"
}

###

# Complete onboarding, accepting an estimated target -> 201 with the created goal.
# Needs PUT /api/v1/me/profile (with a calculationSex) to have run first. Runs once per
# account; a second call returns 409. Height/DOB/sex are read from the saved profile.
POST {{MySelf.Api_HostAddress}}/api/v1/me/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "goalType": "Lose",
  "targetWeightKg": 62,
  "estimate": {
    "weightKg": 68,
    "activityLevel": "Moderate",
    "pace": "Standard"
  }
}

###

# Complete onboarding with a manual target -> 201, source "Manual", no snapshot
POST {{MySelf.Api_HostAddress}}/api/v1/me/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "goalType": "Maintain",
  "manualTarget": { "calorieTarget": 2100, "proteinGrams": 150, "carbGrams": 210, "fatGrams": 60 }
}

###

# Complete onboarding, skipping nutrition -> 201, goal with null targets
POST {{MySelf.Api_HostAddress}}/api/v1/me/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "goalType": "TrackOnly"
}

###

# Goal history, newest first
GET {{MySelf.Api_HostAddress}}/api/v1/me/goals
Authorization: Bearer {{accessToken}}

###

# Logout -> 204, revokes the cookie's refresh token and clears it (needs the Cookie header
# manually pasted from a prior Set-Cookie in this file; a browser does this automatically).
POST {{MySelf.Api_HostAddress}}/api/v1/auth/logout

###

# Forgot password (known email) -> 200; in Development, resetLink is included directly
# (dev-sink, docs/05 — no real email provider yet). It's also logged server-side.
POST {{MySelf.Api_HostAddress}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "demo@example.com"
}

###

# Forgot password (unknown email) -> same 200 message, resetLink is null either way
POST {{MySelf.Api_HostAddress}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "no-such-account@example.com"
}

###

# Reset password -> paste the email + token from the resetLink above
POST {{MySelf.Api_HostAddress}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "email": "demo@example.com",
  "token": "PASTE_TOKEN_HERE",
  "newPassword": "EvenStr0nger!Pass"
}

###

# Invalid/garbage token -> 400 "Invalid reset link"
POST {{MySelf.Api_HostAddress}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "email": "demo@example.com",
  "token": "not-a-real-token",
  "newPassword": "EvenStr0nger!Pass"
}

###

# ============================================================================
# Phase 2 — program builder (all require Authorization: Bearer {{accessToken}})
# ============================================================================

# Search the seeded exercise catalogue
GET {{MySelf.Api_HostAddress}}/api/v1/exercises?q=squat&page=1&pageSize=10
Authorization: Bearer {{accessToken}}

###

# Create a program -> 201 { id, name, ... }
POST {{MySelf.Api_HostAddress}}/api/v1/programs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "PPL", "splitLabel": "Push/Pull/Legs" }

###

# List the caller's programs (active first, archived hidden)
GET {{MySelf.Api_HostAddress}}/api/v1/programs
Authorization: Bearer {{accessToken}}

###

# Full program tree
GET {{MySelf.Api_HostAddress}}/api/v1/programs/PROGRAM_ID
Authorization: Bearer {{accessToken}}

###

# Add a group -> 201
POST {{MySelf.Api_HostAddress}}/api/v1/programs/PROGRAM_ID/groups
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Legs" }

###

# Add a variant -> 201
POST {{MySelf.Api_HostAddress}}/api/v1/workout-groups/GROUP_ID/variants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Legs #1" }

###

# Replace a variant's whole contents (exercises + set prescriptions + supersets) -> 200 detail
PUT {{MySelf.Api_HostAddress}}/api/v1/workout-variants/VARIANT_ID
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Legs #1",
  "estimatedDurationMinutes": 60,
  "exercises": [
    {
      "exerciseId": "EXERCISE_ID_1", "sortOrder": 0, "supersetRef": null, "supersetMemberOrder": 0,
      "restSeconds": 120, "notes": null,
      "sets": [
        { "sortOrder": 0, "kind": "Standard", "isAmrap": false, "targetToFailure": false, "targetRepsMin": 8, "targetRepsMax": 12, "targetWeightKg": 100, "targetRir": 2 },
        { "sortOrder": 1, "kind": "Standard", "isAmrap": true,  "targetToFailure": false, "targetRepsMin": null, "targetRepsMax": null, "targetWeightKg": 90, "targetRir": null }
      ]
    }
  ],
  "supersets": []
}

###

# Activate a program (deactivates the previous active one) -> 204
POST {{MySelf.Api_HostAddress}}/api/v1/programs/PROGRAM_ID/activate
Authorization: Bearer {{accessToken}}

###

# Archive a program -> 204 (hidden from the list, its active flag cleared)
DELETE {{MySelf.Api_HostAddress}}/api/v1/programs/PROGRAM_ID
Authorization: Bearer {{accessToken}}

###

# --- session logging (Phase 3) ---

# Log a performed set (validated by the exercise's tracking mode) -> 200 SetLogDetail
POST {{MySelf.Api_HostAddress}}/api/v1/workout-sessions/SESSION_ID/set-logs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "setLogId": "SET_LOG_ID", "weightKg": 102.5, "reps": 8, "reachedFailure": false }

###

# Skip a set -> 200, skippedAt + reason set, performed values cleared
POST {{MySelf.Api_HostAddress}}/api/v1/workout-sessions/SESSION_ID/skip-set
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "setLogId": "SET_LOG_ID", "reason": "equipment" }

###

# Finish the session -> 200, status Completed, performedOnLocalDate stamped
POST {{MySelf.Api_HostAddress}}/api/v1/workout-sessions/SESSION_ID/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "localDate": "2026-09-04", "notes": "felt strong" }

###

# Discard the in-progress session -> 204
POST {{MySelf.Api_HostAddress}}/api/v1/workout-sessions/SESSION_ID/discard
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

###

# Read one session by id (any status) -> 200
GET {{MySelf.Api_HostAddress}}/api/v1/workout-sessions/SESSION_ID
Authorization: Bearer {{accessToken}}

###

# Workout history (default status=Completed, newest first) -> paginated list with per-session summary
GET {{MySelf.Api_HostAddress}}/api/v1/workout-sessions?status=Completed&page=1&pageSize=20
Authorization: Bearer {{accessToken}}

###

# In-progress sessions only
GET {{MySelf.Api_HostAddress}}/api/v1/workout-sessions?status=InProgress
Authorization: Bearer {{accessToken}}

###
