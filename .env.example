ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=myself;Username=myself;Password=replace_me
# The integration test suite wipes every table it uses, so it runs against a SEPARATE
# database: the same connection with "_test" appended to the DB name (e.g. myself_test).
# It is created + migrated + catalogue-seeded automatically on the first `dotnet test`,
# provided the DB user may create databases:  ALTER ROLE myself CREATEDB;

# Barcode lookup uses Open Food Facts, which needs no key.
# USDA FoodData Central key — only used later for generic food text-search (Phase 5).
NUTRIAPI_KEY=your_fdc_api_key_here

# JWT access-token signing key. Generate your own, e.g.:
#   openssl rand -base64 48
Jwt__Key=replace_with_a_long_random_secret
